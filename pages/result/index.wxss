.loading-block {
  padding: 200rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-ring {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid var(--line);
  border-top-color: var(--ink);
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-tip {
  font-size: 36rpx;
  font-weight: 500;
  margin-top: 40rpx;
  text-align: center;
  line-height: 1.6;
}

.loading-sub {
  font-size: 30rpx;
  color: var(--ink-3);
  margin-top: 16rpx;
}

.score-row {
  display: flex;
  align-items: baseline;
  margin-top: 40rpx;
}

.score-num {
  font-size: 112rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -2rpx;
}

.score-unit {
  font-size: 32rpx;
  color: var(--ink-3);
  margin-left: 12rpx;
}

.score-level {
  margin-left: auto;
  font-size: 34rpx;
  font-weight: 500;
}

.score-level.good { color: var(--good); }
.score-level.warn { color: var(--warn); }
.score-level.risk { color: var(--ink-2); }

.verdict {
  margin-top: 32rpx;
}

.verdict-title {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.5;
}

.dims {
  margin-top: 48rpx;
}

.dim {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.dim:last-child {
  margin-bottom: 0;
}

.dim-label {
  width: 120rpx;
  font-size: 32rpx;
  color: var(--ink-2);
  flex: none;
}

.bar-track {
  flex: 1;
  height: 4rpx;
  background: var(--line);
  border-radius: 2rpx;
}

.bar-fill {
  height: 4rpx;
  border-radius: 2rpx;
}

.bar-fill.ink { background: var(--ink); }
.bar-fill.muted { background: var(--ink-3); }
.bar-fill.warn { background: var(--warn); }

.dim-score {
  width: 48rpx;
  text-align: right;
  font-size: 32rpx;
  font-weight: 600;
  flex: none;
  margin-left: 16rpx;
}

.score-note {
  font-size: 30rpx;
  color: var(--ink-3);
  line-height: 1.8;
  margin-top: 48rpx;
}

.sec-gap {
  margin-top: 80rpx;
}

.garment-wrap {
  position: relative;
  margin-top: 48rpx;
  padding: 24rpx 0;
}

.garment {
  width: 100%;
}

.marker {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  transform: translate(-50%, -50%);
}

.marker.ok {
  background: var(--paper);
  border: 3rpx solid var(--good);
}

.marker.ok::after {
  content: '';
  display: block;
  width: 14rpx;
  height: 24rpx;
  border: solid var(--good);
  border-width: 0 5rpx 5rpx 0;
  transform: rotate(45deg) translate(-2rpx, -4rpx);
}

.marker.warn {
  background: var(--warn);
  border: 3rpx solid var(--warn);
  color: #FFFFFF;
}

.garment-caption {
  font-size: 30rpx;
  color: var(--ink-3);
  text-align: center;
  margin-top: 24rpx;
}

.finding-index {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
  margin-right: 12rpx;
}

.finding-index.warn {
  background: var(--warn);
  color: #FFFFFF;
}

.findings {
  margin-top: 48rpx;
}

.finding {
  padding: 32rpx 0;
  border-top: 2rpx solid var(--line);
}

.finding-head {
  display: flex;
  align-items: baseline;
}

.finding-tag {
  font-size: 30rpx;
  font-weight: 600;
  flex: none;
  margin-right: 16rpx;
}

.finding-tag.good { color: var(--good); }
.finding-tag.warn { color: var(--warn); }

.finding-title {
  font-size: 36rpx;
  font-weight: 500;
}

.finding-detail {
  font-size: 32rpx;
  color: var(--ink-2);
  line-height: 1.8;
  margin-top: 12rpx;
}

.sample-note {
  font-size: 30rpx;
  color: var(--ink-3);
  text-align: center;
  margin-top: 40rpx;
  line-height: 1.6;
}

/* 没读出来 / 没把握：这两块替代整个结果区，不能和分数同时出现 */
.empty-block {
  padding: 120rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  font-size: 40rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.6;
}

.empty-detail {
  font-size: 32rpx;
  color: var(--ink-2);
  text-align: center;
  line-height: 1.8;
  margin-top: 24rpx;
  margin-bottom: 64rpx;
}

.empty-reason {
  font-size: 26rpx;
  color: var(--ink-3);
  text-align: center;
  margin-top: 40rpx;
  line-height: 1.6;
}

/* 真实结果里没看出难穿点：结果照常显示，只在最上面加一条说明 */
.notice {
  background: var(--soft);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
}

.notice-title {
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.6;
}

.notice-detail {
  font-size: 30rpx;
  color: var(--ink-2);
  line-height: 1.8;
  margin-top: 12rpx;
}
