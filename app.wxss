page {
  --ink: #1A1A1A;
  --ink-2: #6E6E6E;
  --ink-3: #A8A8A8;
  --line: #ECECEC;
  --soft: #F7F7F7;
  --good: #3D7A5F;
  --warn: #C77D2B;
  --paper: #FFFFFF;
  --sel: #F7EFE0;
  --icon-bg: #F1EFE8;
  background-color: #FFFFFF;
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 34rpx;
  line-height: 1.7;
}

view, text, button {
  box-sizing: border-box;
}

/* 页面根节点：铺满视口并承载主题类，护眼模式变量从这里往下覆盖 */
.page-root {
  min-height: 100vh;
  background-color: var(--paper);
}

/* 护眼模式：色温整体偏暖，去纯白去纯黑，降低蓝光与对比刺激 */
.theme-warm {
  --ink: #3B3020;
  --ink-2: #7A6A55;
  --ink-3: #A89880;
  --line: #E3D8C2;
  --soft: #EFE6D2;
  --good: #5B6E3F;
  --warn: #B06A28;
  --paper: #F7F1E3;
  --sel: #F0E2C4;
  --icon-bg: #E8DCC2;
}

.page-body {
  padding: 32rpx 48rpx 48rpx;
}

.dots {
  display: flex;
  gap: 12rpx;
  padding: 32rpx 48rpx 0;
}

.dots .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--line);
}

.dots .dot.on {
  background: var(--ink);
}

.q-title {
  font-size: 54rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.q-hint {
  font-size: 32rpx;
  color: var(--ink-3);
  margin-top: 16rpx;
  line-height: 1.7;
}

.btn-main {
  display: block;
  width: 100%;
  background: var(--warn);
  color: #FFFFFF;
  border: none;
  border-radius: 56rpx;
  font-size: 38rpx;
  font-weight: 500;
  padding: 34rpx 0;
  margin-top: 64rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

.btn-main::after {
  border: none;
}

.btn-link {
  display: inline-block;
  background: none;
  border: none;
  font-size: 34rpx;
  color: var(--ink);
  margin-top: 32rpx;
  padding: 0;
  border-bottom: 2rpx solid var(--ink-3);
  padding-bottom: 4rpx;
  line-height: 1.6;
}

.btn-link::after {
  border: none;
}

.foot-note {
  font-size: 30rpx;
  color: var(--ink-3);
  text-align: center;
  margin-top: 32rpx;
  line-height: 1.7;
}

.sec-lbl {
  font-size: 28rpx;
  letter-spacing: 6rpx;
  color: var(--ink-3);
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--line);
  margin-top: 16rpx;
}

.sec-lbl .sec-num {
  font-size: 28rpx;
  letter-spacing: 0;
  margin-right: 16rpx;
  font-weight: 500;
}

.num {
  font-variant-numeric: tabular-nums;
}
