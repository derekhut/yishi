.q-list {
  margin-top: 16rpx;
}

.q-item {
  padding: 32rpx 0;
  border-top: 2rpx solid var(--line);
}

.q-title-row {
  display: flex;
  align-items: baseline;
}

.q-index {
  font-size: 32rpx;
  color: var(--ink-3);
  flex: none;
  margin-right: 20rpx;
}

.q-text {
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.5;
}

.q-detail {
  font-size: 32rpx;
  color: var(--ink-2);
  line-height: 1.8;
  margin-top: 12rpx;
  padding-left: 60rpx;
}

.script-box {
  background: var(--soft);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 48rpx;
}

.script-lbl {
  font-size: 30rpx;
  color: var(--ink-3);
  margin-bottom: 16rpx;
}

.script-text {
  font-size: 34rpx;
  line-height: 1.9;
}

.script-copy {
  display: inline-block;
  font-size: 32rpx;
  color: var(--ink);
  margin-top: 24rpx;
  padding-bottom: 4rpx;
  border-bottom: 2rpx solid var(--ink-3);
}

.try-block {
  margin-top: 56rpx;
}

.try-title {
  font-size: 32rpx;
  color: var(--ink-2);
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--line);
}

.try-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}

/* 勾选框交给小程序自带的 checkbox，不再自己画方块和对勾：
   勾选状态、点击热区、无障碍读屏都由它负责。这里只调间距。 */
.try-ck {
  flex: none;
  margin: 2rpx 16rpx 0 0;
}

.try-text {
  font-size: 34rpx;
  line-height: 1.7;
  color: var(--ink);
}

.try-text.on {
  color: var(--ink-3);
  text-decoration: line-through;
}

.link-wrap {
  text-align: center;
  margin-top: 40rpx;
}
