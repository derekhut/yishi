<view class="page-root {{themeClass}}">

  <view class="dots-row">
    <view class="dots">
      <view wx:for="{{steps}}" wx:key="*this" class="dot {{index <= currentStep ? 'on' : ''}}"></view>
    </view>
    <text class="step-label">第 {{currentStep + 1}} 步，共 {{steps.length}} 步</text>
  </view>

  <view class="page-body">
    <view class="q-title">哪些动作比较费劲？</view>

    <checkbox-group class="opt-list" bindchange="onChange">
      <label
        wx:for="{{options}}"
        wx:key="key"
        class="opt {{item.selected ? 'sel' : ''}}"
      >
        <view class="opt-icon">
          <image class="opt-img" src="{{item.icon}}" mode="aspectFit"></image>
        </view>
        <view class="opt-text">
          <view class="opt-t1">{{item.title}}</view>
        </view>
        <checkbox class="opt-ck" value="{{item.key}}" checked="{{item.selected}}" color="{{switchOnColor}}"></checkbox>
      </label>
    </checkbox-group>

    <button class="btn-main" bindtap="onNext">下一步</button>

    <view class="eye-row">
      <view class="eye-text">
        <view class="eye-t1">护眼模式</view>
      </view>
      <switch class="eye-switch" checked="{{eyeCare}}" bindchange="onEyeChange" color="{{switchOnColor}}"></switch>
    </view>
  </view>

</view>
